# ---- SOS Guard server config ----
PORT=8080

# Admin login for the demo (both default to "admin")
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Session cookie signing secret (any random string for the demo)
SESSION_SECRET=change-me-demo-secret

# ---- LiveKit (self-hosted) ----
# Public URL the apps/browser connect to (wss://...)
LIVEKIT_URL=wss://1v.collab.name.ng
# API key/secret from your LiveKit server (keys.yaml / env on the SFU).
# These MUST match the livekit-server config. Do NOT commit real values.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=please-change-this-to-your-livekit-secret
