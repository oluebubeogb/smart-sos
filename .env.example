# ---- Smart SOS server config ----
PORT=7474
DATA_DIR=/data

# PostgreSQL (REQUIRED). Bundled compose service default:
DATABASE_URL=postgres://smartsos:smartsos@postgres:5432/smartsos
# POSTGRES_PASSWORD=smartsos        # password for the bundled postgres service
# PGSSL=1                           # force TLS (also enabled by ?sslmode=require)

# Superadmin login (env account; creates 2nd-level admins in the UI)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Cookie signing + encryption of stored partner keys. Keep it stable:
# changing it logs everyone out and makes stored keys un-revealable (rotate to fix).
SESSION_SECRET=change-me-demo-secret

# ---- LiveKit (self-hosted) ----
LIVEKIT_URL=wss://1v.collab.name.ng
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=please-change-this-to-your-livekit-secret

# ---- Legacy partner keys (imported ONCE into the DB, then manage them in the admin) ----
# SAFE_CORPS_API_KEY=
# PARTNER_API_KEYS=partner1:key1,partner2:key2
# PARTNER_WEBHOOK_URL=https://...
# PARTNER_WEBHOOK_URLS=partner1=https://...,partner2=https://...
# MIGRATE_LEGACY=1                  # force re-running the idempotent legacy import
